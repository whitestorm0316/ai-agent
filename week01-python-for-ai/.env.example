# 复制这个文件为 .env，填入自己的 key。
# .env 已被 .gitignore 忽略，不会进仓库——两台电脑各自维护一份。

LLM_API_KEY=sk-在这里填你的key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

